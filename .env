# ==========================================
# VR Game Creator Studio - Environment Config
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database & Storage (For saving user projects and assets)
DATABASE_URL=mongodb://localhost:27017/vr-game-creator
UPLOAD_MAX_FILE_SIZE=50MB

# WebXR & Rendering Options
ENABLE_SHADOWS=true
DEFAULT_RENDER_FPS=60

# Authentication & Security (If adding user login later)
JWT_SECRET=super_secret_vr_dev_key_change_in_production
SESSION_TIMEOUT=86400
